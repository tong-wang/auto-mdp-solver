{
  "description": "mdp-guard: the pipeline's executable gates, enforced by the host — a turn cannot end on a completion claim that `mdp_stage` contradicts, and a schema edit that fails `mdp_ir` is fed back immediately.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/mdp_guard.py\"",
            "timeout": 120
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/mdp_guard.py\"",
            "timeout": 120
          }
        ]
      }
    ]
  }
}

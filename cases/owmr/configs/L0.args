# L0 — the library's defaults plus what the problem forces (spec 8.6): 1 env, no normalization, constant lr and clip, 2M steps, terminal only
--level L0
--learning_rate 3e-4 --lr-final 3e-4 --clip-init 0.2 --clip-final 0.2
--n-steps 2048 --batch-size 64 --ent-coef 0 --target-kl -1 --n-envs 1
--no-norm-obs --no-norm-reward --checkpoint-every-frac 0 --total-timesteps 2000000
